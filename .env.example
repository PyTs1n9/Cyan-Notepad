# Public Supabase client configuration. Never put the service_role key here.
#
# The CSP in src-tauri/tauri.conf.json pins these hosts in `connect-src`
# (`https://*.supabase.co`, `wss://*.supabase.co`, `https://*.onrender.com`,
# `wss://*.onrender.com`). Pointing the app at a host outside those patterns
# requires widening connect-src too, otherwise sign-in and collaboration fail
# silently. `npm run verify:batch3` reads this file and fails when they drift.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
VITE_COLLAB_URL=ws://127.0.0.1:1234
# Optional when a reverse proxy exposes /health on a different public URL.
# VITE_COLLAB_HEALTH_URL=https://collab.example.com/health
